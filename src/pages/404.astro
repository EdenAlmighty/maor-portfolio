---
import Base from '../layouts/Base.astro';
import Actions from '../components/Actions.astro';
---

<Base
  title="Page not found"
  description="This page does not exist on Maor Matthew Shaer's portfolio. Try the projects, the CV or the home page."
  noindex
>
  <div class="mp-wrap">
    <section class="mp-sheet mp-404" aria-labelledby="nf-title">
      <p class="mp-404__code">
        <span class="mp-rev">404</span>
        <span class="mp-mono mp-muted">Expected a page. Actual: nothing here.</span>
      </p>
      <h1 id="nf-title" class="mp-h1">
        This page does not exist.
      </h1>
      <p class="mp-lede">The link may be old or mistyped. Try one of these instead:</p>
      <ul class="mp-404__links">
        <li>
          <a class="mp-target" href="/projects">
            All projects
          </a>
        </li>
        <li>
          <a class="mp-target" href="/cv">
            The CV
          </a>
        </li>
        <li>
          <a class="mp-target" href="/">
            The home page
          </a>
        </li>
      </ul>
      <Actions path="/404" />
    </section>
  </div>
</Base>

<style>
  .mp-404 {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  .mp-404__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    padding: 0;
  }
  .mp-404__code {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .mp-404__code .mp-rev {
    inline-size: 3.6em;
    block-size: 3em;
  }
</style>
