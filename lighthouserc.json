{
  "ci": {
    "collect": {
      "startServerCommand": "npm run preview -- --port 4322",
      "startServerReadyPattern": "localhost:4322",
      "url": [
        "http://localhost:4322/",
        "http://localhost:4322/projects",
        "http://localhost:4322/projects/moving-quote-app",
        "http://localhost:4322/cv"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 1500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.05
          }
        ],
        "total-byte-weight": [
          "error",
          {
            "maxNumericValue": 409600
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
