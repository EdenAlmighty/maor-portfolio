{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maor-portfolio",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // about.html is served at /about; /about/ redirects to /about.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Server routes must reach the Worker: with not_found_handling set, unmatched
    // paths are otherwise answered from the static files.
    "run_worker_first": ["/go/*"],
  },
  // TODO(content): Maor's domain and account_id go here at the handover (PLAN.md,
  // "Building before Cloudflare exists, and the handover"). Until then there is no deploy.
  // "routes": [{ "pattern": "maorshaer.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  // /go/ click counts (CV downloads, email, LinkedIn, GitHub). Local D1 works without an
  // account; the real database_id is created in Maor's account at the handover.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maor-portfolio",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
